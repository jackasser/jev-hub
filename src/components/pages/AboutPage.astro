---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClaimsNotice from '../ClaimsNotice.astro';
import { loadEntries } from '../../lib/load';
import { countByCategory } from '../../lib/entries';
import { CATEGORIES, CATEGORY_META, type Locale } from '../../lib/taxonomy';
import { t, localePath } from '../../i18n';
import { GITHUB_URL, CONTACT_EMAIL } from '../../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entries = await loadEntries();
const counts = countByCategory(entries);

const rules: { en: string; ja: string }[] = [
  {
    en: 'Nothing is listed until its page has actually been opened and read. Every entry carries the URLs that were checked, and you can see them on the entry.',
    ja: '実際にページを開いて読むまでは載せない。確認した URL はエントリごとに残してあり、詳細ページで見られる。',
  },
  {
    en: 'Descriptions are written here, in our own words. No pasted README, no pasted abstract, no pasted post.',
    ja: '説明文はこちらで書いている。README や要約や投稿の貼り付けはしない。',
  },
  {
    en: 'A vendor’s figure is labelled as a vendor’s figure. Measurements are listed separately, under Evaluations, and only when the method is published.',
    ja: 'ベンダーの数値はベンダーの数値として書く。測定は「評価・ベンチマーク」に分けて載せ、手順が公開されているものだけを載せる。',
  },
  {
    en: 'Forks and mirrors are left out. Where a project has spread mostly through forks, the upstream is listed and the forks are not.',
    ja: 'フォークとミラーは載せない。フォークで広まっているプロジェクトは、上流だけを載せる。',
  },
  {
    en: 'No referral links, no API keys, no redistributed data. Links and descriptions only.',
    ja: '紹介リンク・API キー・データの再配布は扱わない。リンクと説明だけ。',
  },
  {
    en: 'Cover pictures are not evidence. An entry with a GitHub repository shows the social preview GitHub generates; everything else shows a picture drawn here from the entry id. Its bars are decoration, not a model output.',
    ja: 'カバー画像は根拠ではない。GitHub リポジトリがあるものは GitHub が生成するソーシャルプレビューを、それ以外はこちらで id から描いた絵を出している。絵の中の棒はモデルの出力ではなく飾り。',
  },
];
---

<BaseLayout
  title={t(locale, 'about.title')}
  description={t(locale, 'about.lead')}
  path="/about"
  locale={locale}
>
  <h1>{t(locale, 'about.title')}</h1>
  <p class="lead">{t(locale, 'about.lead')}</p>

  <section class="prose">
    <p>
      {
        locale === 'ja'
          ? 'Jev が公開されてから短い期間に、公式ドキュメント・SDK・中継サービス・互換実装・解説・独立評価が一気に増えた。どれがどれなのかを 1 ページで見渡せるようにするのがこのサイトの目的。'
          : 'In the short time since Jev was published, the documentation, SDKs, relays, compatible implementations, explainers and independent evaluations around it all appeared at once. This site exists so you can see what is what on one page.'
      }
    </p>
    <p>
      {
        locale === 'ja'
          ? `現在の掲載数は ${entries.length} 件。`
          : `There are ${entries.length} entries right now.`
      }
    </p>
  </section>

  <section>
    <div class="section-head">
      <h2>{locale === 'ja' ? '編集方針' : 'Editorial rules'}</h2>
    </div>
    <ol class="steps">
      {rules.map((rule) => <li><p>{rule[locale]}</p></li>)}
    </ol>
  </section>

  <section>
    <div class="section-head">
      <h2>{locale === 'ja' ? 'カテゴリ' : 'Categories'}</h2>
    </div>
    <dl class="facts">
      {
        CATEGORIES.map((c) => (
          <>
            <dt>{counts[c]}</dt>
            <dd>
              <strong>{CATEGORY_META[c].label[locale]}</strong> — {CATEGORY_META[c].blurb[locale]}
            </dd>
          </>
        ))
      }
    </dl>
  </section>

  <section>
    <ClaimsNotice locale={locale} />
  </section>

  <section class="prose">
    <div class="section-head">
      <h2>{locale === 'ja' ? '追加・訂正' : 'Additions and corrections'}</h2>
    </div>
    <p>
      {
        locale === 'ja'
          ? '抜けているもの、事実が違うもの、リンク切れがあれば、リポジトリの issue で知らせてほしい。一次ソースの URL が付いていると早い。'
          : 'If something is missing, wrong or dead, open an issue on the repository. A primary-source URL makes it quick.'
      }
      {' '}
      <a href={GITHUB_URL} rel="noopener noreferrer">{GITHUB_URL}</a>
      {CONTACT_EMAIL && <> · <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></>}
    </p>
    <p><a href={localePath(locale, '/entries')}>{t(locale, 'home.viewAll')}</a></p>
  </section>
</BaseLayout>
