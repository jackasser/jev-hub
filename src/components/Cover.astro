---
import type { Entry } from '../lib/schema';
import { coverFor, generatedCoverPath } from '../lib/media';

interface Props {
  entry: Entry;
  class?: string;
  /** Eager for the cover above the fold on a detail page. */
  eager?: boolean;
}

const { entry, class: extra = 'card__cover', eager = false } = Astro.props;
const cover = coverFor(entry);
const fallback = generatedCoverPath(entry.id);
const external = cover.kind !== 'generated';
// Every entry also has a generated cover on disk, so the fallback always resolves.
const onerror = external
  ? `this.onerror=null;this.src='${fallback}';this.removeAttribute('referrerpolicy')`
  : undefined;
---

<div class={extra} data-cover={cover.kind}>
  <img
    src={cover.src}
    alt=""
    width="1200"
    height="600"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    referrerpolicy={external ? 'no-referrer' : undefined}
    onerror={onerror}
  />
  {'credit' in cover && cover.credit && <span class="cover__credit">{cover.credit}</span>}
</div>
